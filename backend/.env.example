# Copy to backend/.env to override the defaults. `make dev` needs no .env file.
# Never commit a real .env. Every setting is listed in backend/app/config.py.

# local, test, staging or production
SUBLETTE_ENV=local

# The local database started by `make db`
SUBLETTE_DATABASE_URL=postgresql+psycopg://sublette:sublette@localhost:5432/sublette

# --- Needed on staging and production ---------------------------------------

# Signs sign-in tokens. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# SUBLETTE_SECRET_KEY=

# Where phones reach this server (used for photo addresses with local storage)
# SUBLETTE_PUBLIC_BASE_URL=https://your-staging-host

# Email. "console" prints codes in the server log; "smtp" or "brevo" sends them.
# Render's free plan blocks SMTP, so use brevo there:
# SUBLETTE_EMAIL_BACKEND=brevo
# SUBLETTE_BREVO_API_KEY=
# SUBLETTE_EMAIL_FROM=Sublette <the-sender-you-verified-in-brevo@gmail.com>
#
# SUBLETTE_EMAIL_BACKEND=smtp
# SUBLETTE_EMAIL_FROM=Sublette <verify@your-domain>
# SUBLETTE_SMTP_HOST=smtp.resend.com
# SUBLETTE_SMTP_PORT=587
# SUBLETTE_SMTP_USERNAME=resend
# SUBLETTE_SMTP_PASSWORD=

# Photos. "local" keeps them in a folder; "s3" is any S3-compatible store.
# SUBLETTE_STORAGE_BACKEND=s3
# SUBLETTE_S3_BUCKET=
# SUBLETTE_S3_REGION=auto
# SUBLETTE_S3_ENDPOINT_URL=
# SUBLETTE_S3_ACCESS_KEY_ID=
# SUBLETTE_S3_SECRET_ACCESS_KEY=
# SUBLETTE_S3_PUBLIC_BASE_URL=

# Comma-separated email domains that may not sign up
# SUBLETTE_BLOCKED_EMAIL_DOMAINS=
